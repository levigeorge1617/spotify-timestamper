# Copy to .env for local development. On Render, set these in the dashboard instead.

# From your Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# PIN that unlocks the /admin and /player pages. Choose something private.
ADMIN_PIN=change-me

# Postgres connection string. Render injects this automatically from the database.
# For local dev: postgres://user:pass@localhost:5432/jukebox
DATABASE_URL=

# Optional: port (Render sets this automatically)
PORT=3000
